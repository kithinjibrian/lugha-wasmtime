/**
 * Guest memory: bounds-checked reads and writes of an instance's exported
 * linear memory. Never reads or writes past the memory's current size, which
 * is read again on every call because the guest may grow it in between.
 * Not responsible for finding instances: see `instance` and `linker`.
 *
 * Depends on: raw
 * Used by: instance, linker, lib
 */

import raw;

/** Why a memory lookup, read or write failed. */
public enum MemoryError {
    /** Its store was closed, or it came from a host call that has returned. */
    Closed,
    /** The instance has no export by this name. */
    MissingExport(string),
    /** The export by this name isn't a memory. */
    NotAMemory(string),
    /** `(offset, len, size)`: `offset + len` passes the memory's `size` in bytes, or overflows. */
    OutOfBounds(u64, u64, u64),
}

/**
 * One linear memory of a running guest. Valid while its store is open; one
 * reached from a host function's `Caller` only during that call.
 */
public struct Memory {
    memory: raw.wasmtime_memory_t,
    context: raw.wasmtime_context_t,
    live: Ref<bool>,
}

/** An extern for C to fill. */
fun empty_extern(): raw.wasmtime_extern_t = raw.wasmtime_extern_t {
    kind: 255,
    of_: raw.wasmtime_extern_union_t { sharedmemory: 0 },
};

/**
 * The memory in `item`, an export named `name` found in `context`, or why
 * it isn't one. Frees `item` (a memory has no destructor, so the copy stays valid).
 */
fun memory_from(
    item: raw.wasmtime_extern_t,
    name: string,
    context: raw.wasmtime_context_t,
    live: Ref<bool>,
): Result<Memory, MemoryError> {
    let mut owned = item;
    let kind = owned.kind;
    let memory = owned.of_.memory;
    raw.wasmtime_extern_delete(mut owned);
    if kind != raw.WASMTIME_EXTERN_MEMORY() {
        return Err(MemoryError.NotAMemory(name));
    }
    Ok(Memory { memory: memory, context: context, live: live })
}

impl Memory {
    /**
     * Returns the memory's current size.
     *
     * @returns the size in bytes (a multiple of 65536); `Err(Closed)` if its store or host call is over
     *
     * Example:
     *     let bytes = memory.size()?;
     */
    public fun size(self): Result<u64, MemoryError> {
        if !self.live.get() {
            return Err(MemoryError.Closed);
        }
        Ok(raw.wasmtime_memory_data_size(self.context, ptr self.memory))
    }

    /**
     * Checks that `len` bytes at `offset` lie inside the memory as it is now.
     *
     * @returns `Ok(())`, or `Err(OutOfBounds)` / `Err(Closed)`
     */
    fun check(self, offset: u64, len: u64): Result<(), MemoryError> {
        let size = self.size()?;
        match offset.checked_add(len) {
            Some(end) if end <= size => Ok(()),
            _ => Err(MemoryError.OutOfBounds(offset, len, size)),
        }
    }

    /**
     * Copies `len` bytes starting at `offset` out of the guest's memory.
     *
     * @param offset byte offset into the memory, such as a pointer the guest passed
     * @param len number of bytes
     * @returns the bytes; `Err(OutOfBounds)` if `offset + len` passes the
     *     memory's size; `Err(Closed)` if its store or host call is over
     *
     * Example:
     *     let text = memory.read(ptr, len)?;
     */
    public fun read(self, offset: u64, len: u64): Result<u8[], MemoryError> {
        self.check(offset, len)?;
        if len == 0 {
            return Ok([]);
        }
        // Checked against the size read just now; the base is read after, so
        // a grown (moved) memory is never copied from its old place.
        Ok(c_read(raw.wasmtime_memory_data(self.context, ptr self.memory), offset, len))
    }

    /**
     * Copies `bytes` into the guest's memory starting at `offset`.
     *
     * @param offset byte offset into the memory
     * @returns `Ok(())`; `Err(OutOfBounds)` if the bytes would pass the
     *     memory's size, in which case nothing is written; `Err(Closed)` if its
     *     store or host call is over
     *
     * Example:
     *     memory.write(ptr, "hello".to_bytes())?;
     */
    public fun write(self, offset: u64, bytes: u8[]): Result<(), MemoryError> {
        self.check(offset, bytes.len as u64)?;
        if bytes.len == 0 {
            return Ok(());
        }
        c_write(raw.wasmtime_memory_data(self.context, ptr self.memory), offset, bytes);
        Ok(())
    }
}
